# Required: does the listening, thinking (Claude), and speaking.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
THINK_MODEL=claude-sonnet-5
# Flux is Deepgram's turn-taking-aware STT/TTS pair, built for voice agents. Set these to
# aura-2-thalia-en / nova-3 instead to fall back to the older, non-Flux voices/models.
SPEAK_MODEL=flux-kit-en
LISTEN_MODEL=flux-general-en
# Optional Flux STT end-of-turn tuning (only applies when LISTEN_MODEL starts with "flux"):
# FLUX_EOT_THRESHOLD=0.7
# FLUX_EAGER_EOT_THRESHOLD=
# FLUX_EOT_TIMEOUT_MS=5000

# Optional: web search tool. Get a free key at https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Optional: Gmail + Google Calendar tools. Create an OAuth 2.0 Web application client at
# https://console.cloud.google.com/apis/credentials, with this redirect URI:
#   http://localhost:4400/auth/google/callback
# and enable the Gmail API + Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=4400
